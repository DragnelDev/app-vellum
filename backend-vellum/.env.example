NODE_ENV=development
PORT=3001
FRONTEND_URL=http://localhost:3000
PUBLIC_API_URL=http://localhost:3001

# PostgreSQL
DATABASE_URL=postgres://vellum:vellum@localhost:5432/vellum
DATABASE_SSL=false
# true crea/ajusta tablas automáticamente (solo desarrollo). En producción: false + migraciones
DB_SYNCHRONIZE=true

# Auth
JWT_SECRET=cambia-esto-por-un-secreto-largo-de-al-menos-32-caracteres
JWT_EXPIRES_IN=30d

# Administrador inicial (se crea al arrancar si no existe)
ADMIN_EMAIL=admin@vellum.local
ADMIN_USERNAME=admin
ADMIN_PASSWORD=cambia-esta-clave

# Almacenamiento: "local" (desarrollo) o "r2" (Cloudflare R2)
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=vellum
# URL pública del bucket servida por Cloudflare CDN (dominio personalizado), sin "/" final
R2_PUBLIC_URL=https://cdn.tudominio.com

# Correo (recuperar contraseña). Sin SMTP_HOST el enlace se imprime en la consola del backend.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Vellum <no-reply@tudominio.com>
